<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f19">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/adminSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/adminWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0b0f19" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/adminProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/adminErrorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#0b0f19"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ ADMIN CONSOLE"
            android:textColor="#f59e0b"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adminErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Cannot reach the Fantasy11 Admin backend."
            android:textColor="#94a3b8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAdminRetry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#d97706"
            android:text="RETRY CONNECTION"
            android:textColor="#0b0f19" />

        <Button
            android:id="@+id/btnAdminChangeServer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="CONFIGURE SERVER IP"
            android:textColor="#f59e0b" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
